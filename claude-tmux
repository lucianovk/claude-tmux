#!/usr/bin/env bash
# Gerencia sessões do Claude Code dentro do tmux, para qualquer projeto.
#
# Uso:
#   claude-tmux iniciar     [NOME]  inicia o Claude no tmux e conecta
#   claude-tmux desconectar [NOME]  sai do tmux sem fechar o Claude
#   claude-tmux conectar    [NOME]  volta à sessão tmux
#   claude-tmux encerrar    [NOME]  fecha a sessão tmux e o Claude
#   claude-tmux estado      [NOME]  mostra se a sessão está ativa
#   claude-tmux lista               lista as sessões tmux
#   claude-tmux conversas           lista as conversas com nome e a pasta de cada uma
#
# NOME é o nome dado à conversa com /rename (ou --name), ou o ID dela.
# "iniciar NOME" acha a pasta onde a conversa foi criada, abre o tmux nela
# e roda "claude --resume ID". Pode ser chamado de qualquer pasta. Se duas
# conversas tiverem o mesmo nome, usa a mais recente e avisa.
#
# Sem NOME, "iniciar" usa a pasta atual e roda "claude --continue", que
# retoma a conversa mais recente dessa pasta (ou abre uma nova). A sessão
# tmux recebe o nome da pasta. Os outros comandos sem NOME também usam o
# nome da pasta atual.
#
# Variável opcional:
#   CLAUDE_TMUX_DIR  força a pasta de trabalho do "iniciar"

set -euo pipefail

PROJETOS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"

ACAO="${1:-}"
CONVERSA="${2:-}"

# O tmux não aceita "." nem ":" em nomes de sessão.
nome_tmux() { local n="$1"; printf '%s' "${n//[.:]/_}"; }

if [[ -n "$CONVERSA" ]]; then
    NOME="$(nome_tmux "$CONVERSA")"
else
    NOME="$(nome_tmux "$(basename "$PWD")")"
fi

existe() { tmux has-session -t "=$NOME" 2>/dev/null; }
exige()  { existe || { echo "A sessão '$NOME' não existe." >&2; exit 1; }; }

conectar() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$NOME"
    else
        tmux attach-session -t "=$NOME"
    fi
}

uso() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

# Lê os históricos do Claude. Com "listar", imprime todas as conversas com
# nome; com um NOME ou ID, imprime "ID<tab>PASTA" da conversa correspondente.
conversas() {
    python3 -I - "$PROJETOS" "$@" <<'PY'
import json, os, re, sys
from glob import glob

base, pedido = sys.argv[1], sys.argv[2]
uuid = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')

def ler(arq):
    titulo = pasta = None
    with open(arq, encoding='utf-8', errors='replace') as f:
        for linha in f:
            if '"customTitle"' not in linha and (pasta or '"cwd"' not in linha):
                continue
            try:
                d = json.loads(linha)
            except ValueError:
                continue
            if d.get('type') == 'custom-title':
                titulo = d.get('customTitle')      # vale o último /rename
            if pasta is None and d.get('cwd'):
                pasta = d['cwd']                   # pasta onde a conversa começou
    return titulo, pasta

arqs = sorted(glob(os.path.join(base, '*', '*.jsonl')), key=os.path.getmtime, reverse=True)

if pedido == 'listar':
    for a in arqs:
        t, p = ler(a)
        if t:
            print(f"{t}\t{p or '?'}\t{os.path.basename(a)[:-6]}")
    sys.exit(0)

achados = []
for a in arqs:
    sid = os.path.basename(a)[:-6]
    if uuid.match(pedido):
        if sid == pedido:
            achados.append((sid, ler(a)[1]))
            break
        continue
    t, p = ler(a)
    if t == pedido:
        achados.append((sid, p))

if not achados:
    sys.exit(f"Nenhuma conversa chamada '{pedido}' em {base}.")
if len(achados) > 1:
    print(f"Aviso: {len(achados)} conversas se chamam '{pedido}'; usando a mais recente.",
          file=sys.stderr)
sid, pasta = achados[0]
if not pasta or not os.path.isdir(pasta):
    sys.exit(f"A pasta da conversa '{pedido}' não existe mais: {pasta}")
print(f"{sid}\t{pasta}")
PY
}

case "$ACAO" in
    iniciar)
        if existe; then
            echo "A sessão '$NOME' já existe; conectando."
        else
            if [[ -n "$CONVERSA" ]]; then
                IFS=$'\t' read -r ID DIR < <(conversas "$CONVERSA") || exit 1
                DIR="${CLAUDE_TMUX_DIR:-$DIR}"
                cmd="claude --resume $ID"
            else
                DIR="${CLAUDE_TMUX_DIR:-$PWD}"
                cmd="claude --continue"
            fi
            tmux new-session -d -s "$NOME" -c "$DIR" "$cmd"
            echo "Sessão '$NOME' criada em $DIR ($cmd)."
        fi
        conectar
        ;;
    desconectar)
        exige
        tmux detach-client -s "=$NOME"
        echo "Desconectado; o Claude continua rodando em '$NOME'."
        ;;
    conectar)
        exige
        conectar
        ;;
    encerrar)
        exige
        tmux kill-session -t "=$NOME"
        echo "Sessão '$NOME' encerrada."
        ;;
    estado)
        if existe; then
            tmux list-sessions -F '#{session_name}: #{session_windows} janela(s), #{?session_attached,conectada,desconectada}' \
                | command grep -F "$NOME:"
        else
            echo "A sessão '$NOME' não existe."
        fi
        ;;
    lista)
        tmux list-sessions -F '#{session_name}: #{?session_attached,conectada,desconectada}' 2>/dev/null \
            || echo "Nenhuma sessão tmux ativa."
        ;;
    conversas)
        conversas listar | column -t -s $'\t'
        ;;
    -h|--help|ajuda) uso 0 ;;
    *) uso 1 ;;
esac
