#!/usr/bin/env bash
# Manage Claude Code sessions inside tmux, for any project.
#
# Usage:
#   claude-tmux start  [NAME]  start Claude in tmux and attach
#   claude-tmux detach [NAME]  leave tmux; Claude keeps running
#   claude-tmux attach [NAME]  go back to the tmux session
#   claude-tmux stop   [NAME]  close the tmux session and Claude
#   claude-tmux status [NAME]  show whether the session is running
#   claude-tmux list           list tmux sessions
#   claude-tmux conversations  list named conversations and their folders
#
# Each folder is a project. "start NAME" opens tmux in the project folder
# and works from anywhere. NAME can be, in order of precedence:
#   - a conversation name (/rename or --name): resumes that conversation;
#   - a conversation ID: resumes that conversation;
#   - the name of a folder where you have used Claude: resumes its most
#     recent conversation;
#   - a folder path (contains "/"): same, and also works for a new project.
# When a name is ambiguous, the most recent match wins and a warning is shown.
#
# Without NAME, "start" uses the current folder and runs "claude --continue",
# which resumes the folder's most recent conversation (or starts a new one).
# The tmux session is named after the folder. The other commands without
# NAME also use the current folder's name.
#
# Optional variable:
#   CLAUDE_TMUX_DIR  force the working folder used by "start"

set -euo pipefail

PROJECTS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"

ACTION="${1:-}"
TARGET="${2:-}"

# tmux does not accept "." or ":" in session names.
tmux_name() { local n="$1"; printf '%s' "${n//[.:]/_}"; }

if [[ "$TARGET" == */* || "$TARGET" == . || "$TARGET" == .. ]]; then
    NAME="$(tmux_name "$(basename "$(realpath -m "$TARGET")")")"   # path: use the folder name
elif [[ -n "$TARGET" ]]; then
    NAME="$(tmux_name "$TARGET")"
else
    NAME="$(tmux_name "$(basename "$PWD")")"
fi

exists()  { tmux has-session -t "=$NAME" 2>/dev/null; }
require() { exists || { echo "Session '$NAME' does not exist." >&2; exit 1; }; }

attach() {
    if [[ -n "${TMUX:-}" ]]; then
        tmux switch-client -t "=$NAME"
    else
        tmux attach-session -t "=$NAME"
    fi
}

usage() { sed -n '2,/^$/p' "$0" | sed -n 's/^# \{0,1\}//p'; exit "${1:-0}"; }

# Read Claude Code's history. With --list, print every named conversation;
# with a NAME, ID or path, print "ID<tab>FOLDER" ("continue" instead of an ID
# when the most recent conversation of the folder should be resumed).
conversations() {
    python3 -I - "$PROJECTS" "$@" <<'PY'
import json, os, re, sys
from glob import glob

base, query = sys.argv[1], sys.argv[2]
uuid = re.compile(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')

def read(path):
    title = folder = None
    with open(path, encoding='utf-8', errors='replace') as f:
        for line in f:
            if '"customTitle"' not in line and (folder or '"cwd"' not in line):
                continue
            try:
                d = json.loads(line)
            except ValueError:
                continue
            if d.get('type') == 'custom-title':
                title = d.get('customTitle')      # the last /rename wins
            if folder is None and d.get('cwd'):
                folder = d['cwd']                 # folder where the conversation started
    return title, folder

files = sorted(glob(os.path.join(base, '*', '*.jsonl')), key=os.path.getmtime, reverse=True)

if query == '--list':
    for f in files:
        t, p = read(f)
        if t:
            print(f"{t}\t{p or '?'}\t{os.path.basename(f)[:-6]}")
    sys.exit(0)

# Folder path: resume its most recent conversation (or start a new one).
if '/' in query or query in ('.', '..'):
    folder = os.path.realpath(os.path.expanduser(query))
    if not os.path.isdir(folder):
        sys.exit(f"Folder '{query}' does not exist.")
    print(f"continue\t{folder}")
    sys.exit(0)

matches, projects = [], []
for f in files:
    sid = os.path.basename(f)[:-6]
    if uuid.match(query):
        if sid == query:
            matches.append((sid, read(f)[1]))
            break
        continue
    t, p = read(f)
    if t == query:
        matches.append((sid, p))
    elif p and os.path.basename(p.rstrip('/')) == query and p not in projects:
        projects.append(p)                       # most recent first

if matches:
    if len(matches) > 1:
        print(f"Warning: {len(matches)} conversations are named '{query}'; using the most recent.",
              file=sys.stderr)
    sid, folder = matches[0]
elif projects:
    if len(projects) > 1:
        print(f"Warning: {len(projects)} folders are named '{query}'; using {projects[0]}.",
              file=sys.stderr)
    sid, folder = 'continue', projects[0]
else:
    sys.exit(f"No conversation or project folder named '{query}'. "
             f"For a new project, pass the folder path.")

if not folder or not os.path.isdir(folder):
    sys.exit(f"Folder '{folder}' no longer exists.")
print(f"{sid}\t{folder}")
PY
}

case "$ACTION" in
    start|iniciar)
        if exists; then
            echo "Session '$NAME' already exists; attaching."
        else
            if [[ -n "$TARGET" ]]; then
                IFS=$'\t' read -r ID DIR < <(conversations "$TARGET") || exit 1
                DIR="${CLAUDE_TMUX_DIR:-$DIR}"
                if [[ "$ID" == continue ]]; then
                    cmd="claude --continue"
                else
                    cmd="claude --resume $ID"
                fi
            else
                DIR="${CLAUDE_TMUX_DIR:-$PWD}"
                cmd="claude --continue"
            fi
            tmux new-session -d -s "$NAME" -c "$DIR" "$cmd"
            echo "Session '$NAME' created in $DIR ($cmd)."
        fi
        attach
        ;;
    detach|desconectar)
        require
        tmux detach-client -s "=$NAME"
        echo "Detached; Claude keeps running in '$NAME'."
        ;;
    attach|conectar)
        require
        attach
        ;;
    stop|encerrar)
        require
        tmux kill-session -t "=$NAME"
        echo "Session '$NAME' closed."
        ;;
    status|estado)
        if exists; then
            tmux list-sessions -F '#{session_name}: #{session_windows} window(s), #{?session_attached,attached,detached}' \
                | command grep -F "$NAME:"
        else
            echo "Session '$NAME' does not exist."
        fi
        ;;
    list|lista)
        tmux list-sessions -F '#{session_name}: #{?session_attached,attached,detached}' 2>/dev/null \
            || echo "No tmux sessions running."
        ;;
    conversations|conversas)
        conversations --list | column -t -s $'\t'
        ;;
    -h|--help|help) usage 0 ;;
    *) usage 1 ;;
esac
